  "author": "Joshua Guo",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/jshguo-labs/monohud.git", "directory": "packages/css" },
  "homepage": "https://github.com/jshguo-labs/monohud#readme",
