{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@monohud/tokens": ["packages/tokens/src/index.ts"],
      "@monohud/fx": ["packages/fx/src/index.ts"],
      "@monohud/react": ["packages/react/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/demo/src", "vitest.setup.ts", "vite-env.d.ts"]
}
